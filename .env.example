# Runtime environment variables for the Fargate task / local dev.
# Copy to .env for local use; in AWS these are set by the CDK stack.

# --- ASR (faster-whisper) ---
# Model id or local path. "base" = bundled base model (CPU, no GPU).
# Swap in a fine-tuned, CTranslate2-int8 model path here later — no code change.
ASR_MODEL=base

# --- Graviton numerics fix (see 01_附录2) ---
# Multi-threaded oneDNN/ACL kernels corrupt the Kokoro vocoder on Graviton.
# Single thread is mandatory for clean audio; fp32 is cheap insurance.
OMP_NUM_THREADS=1
DNNL_DEFAULT_FPMATH_MODE=F32

# --- Phase 3 avatar pipeline (only set when AvatarStack is deployed) ---
# Unset -> /avatar returns 503 (degrades cleanly).
# AVATAR_BUCKET=
# AVATAR_QUEUE_URL=
# AVATAR_TABLE=
# AVATAR_DEFAULT_IMAGE_KEY=portraits/default.jpg

# --- Test/CI only ---
# SKIP_MODEL_LOAD=1   # skip warming the TTS model at startup (used by pytest)
